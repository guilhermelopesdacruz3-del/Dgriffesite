# ============================================================
# Ótica — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
#   PowerShell:  copy .env.example .env
# ============================================================

# ------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# Local (Docker incluído no repo): postgresql://postgres:postgres@localhost:5432/otica
# Neon/Supabase: copie a string de conexão do painel.
# DIRECT_URL: opcional — conexão direta (sem PgBouncer) para migrações (Neon/Supabase).
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otica"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/otica"

# ------------------------------------------------------------
# IDENTIDADE DA LOJA (troca fácil — a fonte única é src/lib/config.ts)
# ------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="Óptica Performance"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------
# AUTENTICAÇÃO — NextAuth v5 (Auth.js)
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -base64 32`
# Google OAuth: console.cloud.google.com → Credenciais → OAuth 2.0
#   Origem autorizada: http://localhost:3000
#   Redirect URI: http://localhost:3000/api/auth/callback/google
# ------------------------------------------------------------
AUTH_SECRET="troque-por-um-segredo-longo-aleatorio"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Senhas padrão criadas pelo seed (troque ao entrar em produção)
SEED_ADMIN_PASSWORD="Admin@1234"

# ------------------------------------------------------------
# PAGAMENTOS — Mercado Pago (faça os testes com credenciais de teste)
# developers.mercadopago.com → Suas integrações → Credenciais
# WEBHOOK_SECRET: aparece na configuração do webhook no painel
# ------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# ------------------------------------------------------------
# E-MAILS — Resend (resend.com)
# SEM a chave configurada a loja não quebra: reset de senha e confirmação
# de pedido ficam registrados no console do servidor (modo desenvolvimento).
# Com a chave: e-mails reais (o remetente usa um domínio verificado no Resend).
# ------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Óptica Performance <nao-responda@seudominio.com.br>"

# ------------------------------------------------------------
# ARMAZENAMENTO S3 (Cloudflare R2 ou AWS S3)
# URLs de upload são assinadas no servidor — nunca exponha chaves no front.
# ------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Domínio público do bucket ( CDN / r2.dev ) usado para servir imagens e .glb
S3_PUBLIC_URL=""

# ------------------------------------------------------------
# FRETE (opcional) — Melhor Envio. Fixture para testes: AKmUw4gXYodZoyLqPrz6aOSpuZZLIxQ9aHF
# Sem token, o frete usa a tabela configurável no admin.
# ------------------------------------------------------------
MELHOR_ENVIO_TOKEN=""

# ------------------------------------------------------------
# OBSERVABILIDADE (opcional) — Sentry
# ------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
